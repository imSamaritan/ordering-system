{
    "name": "imsamaritan/ordering-system",
    "description": "Produce & Inventory Ordering System built with Slim 4, dibi, Phinx, Tailwind CSS, TypeScript and Alpine.js",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "slim/php-view": "^3.4",
        "php-di/php-di": "^7.0",
        "dibi/dibi": "^5.0",
        "firebase/php-jwt": "^7.0",
        "phpmailer/phpmailer": "^6.9",
        "dompdf/dompdf": "^3.0",
        "vlucas/phpdotenv": "^5.6",
        "robmorgan/phinx": "^0.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "phinx migrate",
        "seed": "phinx seed:run"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
