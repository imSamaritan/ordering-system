APP_NAME="Produce & Inventory Ordering System"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/projects/ordering-system
APP_BASE_PATH=/projects/ordering-system
APP_CURRENCY=ZAR
APP_CURRENCY_SYMBOL=R

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ordering_system
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

JWT_SECRET=change-me-to-a-64-char-random-secret
JWT_TTL_SECONDS=86400
JWT_COOKIE_NAME=ordering_auth_token

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=
SMTP_FROM_EMAIL=no-reply@ordering-system.local
SMTP_FROM_NAME="Produce & Inventory Ordering System"

SUPPLIER_EMAIL=supplier@freshproduce.co.za
SUPPLIER_PASSWORD=change-me-supplier-password
